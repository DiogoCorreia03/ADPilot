DEBUG=False

# LangSmith Tracing Configuration (optional, set LANGSMITH_TRACING=false to disable)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT="https://eu.api.smith.langchain.com"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT=""

# MCP Server Configuration
# Endpoint where the attacker machine MCP server is accessible
ATTACKER_MACHINE_URL="https://example.endpoint.com/mcp"
# ATTACKER_MACHINE_URL="http://127.0.0.1:8080/mcp"

# Basic auth credentials for accessing the MCP server (e.g. configured in ngrok)
ATTACKER_MACHINE_AUTH_TOKEN="user:password"

# Target Network Configuration
NETWORK="192.168.122.0/24"
DC_IP="192.168.122.10"

# Comma separated list of hosts to ignore during scans/recon
IGNORED_HOSTS="192.168.122.1,192.168.122.2,192.168.122.57"

# Model Configuration
# MODEL_MODE options: "local", "remote", or "hybrid"
# - "local": Uses LOCAL_MODEL (e.g. Ollama); REMOTE_API_KEY is not required
# - "remote" (default): Uses REMOTE_MODEL with either REMOTE_API_KEY or GCP_PROJECT (for Google ADC)
# - "hybrid": Uses REMOTE_MODEL for planning, exploitation, and reporting; LOCAL_MODEL for extraction and checks
MODEL_MODE="remote"
LOCAL_MODEL="qwen2.5"
REMOTE_MODEL="gemini-2.5-flash"
REMOTE_API_KEY=""
MODEL_PROVIDER="" # Optional: e.g. "google-genai", "openai", "anthropic". If not provided, LangChain will attempt to infer the provider from REMOTE_MODEL.

# GCP project ID when using Google ADC (can be used instead of REMOTE_API_KEY for Google models)
# GCP_PROJECT="your-project-id"

# Interactive CLI (set to true to enable the possibility of forcing phase changes during execution)
ENABLE_INTERACTIVE_CLI=true

# Execution & Retry Limits (optional, defaults shown)
# EXPLOIT_MAX_TOOL_CALLS=10
# EXPLOIT_MAX_SAME_TOOL_CALLS_IN_A_ROW=5
# CHECK_MAX_RETRIES=3
# LLM_RETRY_MAX_ATTEMPTS=3
# LLM_RETRY_BASE_DELAY=1.0
# LLM_RETRY_MAX_DELAY=30.0